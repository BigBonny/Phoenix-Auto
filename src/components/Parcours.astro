---
import Icon from './Icon.astro';
import { steps, reasons } from '../data/site';
---
<section class="section section--sand parcours" id="parcours" aria-labelledby="parcours-title">
  <div class="parcours__glow" aria-hidden="true"></div>
  <div class="container parcours__grid">
    <div class="parcours__intro">
      <div class="parcours__sticky">
        <p class="eyebrow" data-reveal>Votre parcours</p>
        <h2 id="parcours-title" class="section-title" data-split>
          De la première leçon <span class="serif brand-text">au permis en poche.</span>
        </h2>
        <p class="section-lead" data-reveal style="--d:200ms">
          Un accompagnement clair, étape par étape. Vous savez toujours où vous en êtes
          et ce qu’il reste à faire.
        </p>
        <a href="#contact" class="btn btn--primary parcours__cta" data-reveal style="--d:300ms" data-magnetic>
          Commencer par l’évaluation <Icon name="arrow" class="arrow" />
        </a>
      </div>
    </div>

    <ol class="timeline" role="list" data-progress>
      <span class="timeline__rail" aria-hidden="true"><span class="timeline__fill"></span></span>
      {steps.map((s, i) => (
        <li class="timeline__step" data-reveal style={`--i:0`}>
          <span class="timeline__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <p class="timeline__kicker">Étape {i + 1}</p>
            <h3 class="timeline__title">{s.title}</h3>
            <p class="timeline__text">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <div class="container">
    <ul class="reasons" role="list">
      {reasons.map((r, i) => (
        <li class="reasons__item" data-reveal style={`--i:${i}`}>
          <span class="reasons__icon"><Icon name={r.icon} /></span>
          <h3 class="reasons__title">{r.title}</h3>
          <p class="reasons__text">{r.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .parcours { overflow: clip; }
  .parcours__glow {
    position: absolute; width: 70vmax; height: 70vmax; left: -30vmax; top: 10%;
    background: radial-gradient(circle, rgba(34, 180, 85, 0.08), transparent 60%);
    pointer-events: none;
  }
  .parcours__grid {
    position: relative;
    display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2.5rem, 1rem + 6vw, 7rem);
  }
  .parcours__sticky { position: sticky; top: 120px; }
  .parcours__cta { margin-top: var(--s-6); }

  .timeline { position: relative; display: grid; gap: clamp(2.5rem, 2rem + 2vw, 4rem); padding-left: 0; list-style: none; --p: 0; }
  .timeline__rail {
    position: absolute; left: 31px; top: 12px; bottom: 12px; width: 2px;
    background: var(--sand-2); border-radius: 2px; overflow: hidden;
  }
  .timeline__fill {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, var(--brand-bright), var(--lime));
    transform-origin: top; transform: scaleY(var(--p));
  }
  .timeline__step { position: relative; display: grid; grid-template-columns: 64px 1fr; gap: var(--s-5); }
  .timeline__num {
    position: relative; z-index: 1;
    display: grid; place-items: center;
    width: 64px; height: 64px; border-radius: 50%;
    font-family: var(--font-display); font-weight: 700; font-size: 1.1rem;
    background: var(--paper); color: var(--fg-muted);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background var(--t-slow) var(--ease-out), color var(--t-slow), box-shadow var(--t-slow);
  }
  .timeline__step.is-in .timeline__num {
    background: var(--grad-brand); color: var(--ink);
    box-shadow: 0 0 0 8px rgba(34, 180, 85, 0.12), 0 10px 24px -6px rgba(34, 180, 85, 0.5);
    transition-delay: 300ms;
  }
  .timeline__kicker { font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; color: var(--brand); padding-top: 6px; }
  .timeline__title { font-size: var(--fs-lg); margin-top: var(--s-2); letter-spacing: -0.02em; }
  .timeline__text { margin-top: var(--s-3); color: var(--fg-muted); max-width: 52ch; }

  .reasons {
    margin-top: var(--section-y);
    display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-4);
    list-style: none; padding: 0;
  }
  .reasons__item {
    padding: var(--s-6) var(--s-5);
    border-radius: var(--r-lg);
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: box-shadow var(--t-med), transform var(--t-med) var(--ease-out);
  }
  .reasons__item:hover { box-shadow: inset 0 0 0 1px rgba(21, 128, 61, 0.3), var(--shadow-2); transform: translateY(-4px); }
  .reasons__icon {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px;
    background: var(--grad-brand-soft); color: var(--brand);
  }
  .reasons__title { margin-top: var(--s-5); font-size: 1.15rem; letter-spacing: -0.015em; }
  .reasons__text { margin-top: var(--s-2); color: var(--fg-muted); font-size: var(--fs-sm); }

  @media (max-width: 960px) {
    .parcours__grid { grid-template-columns: 1fr; }
    .parcours__sticky { position: static; }
    .reasons { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .reasons { grid-template-columns: 1fr; }
    .timeline__step { grid-template-columns: 52px 1fr; gap: var(--s-4); }
    .timeline__num { width: 52px; height: 52px; font-size: 1rem; }
    .timeline__rail { left: 25px; }
  }
</style>
