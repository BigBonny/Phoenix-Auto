---
interface Props {
  size?: number;
  withText?: boolean;
  id?: string;
}
const { size = 40, withText = true, id = 'lg' } = Astro.props;
---
<span class="logo">
  <!-- Sceau « Préfecture » : tampon cranté + volant -->
  <svg class="logo__mark" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={`${id}-brand`} x1="0" y1="1" x2="0.6" y2="0">
        <stop offset="0" stop-color="#15803d" />
        <stop offset="0.6" stop-color="#22b455" />
        <stop offset="1" stop-color="#b5f04a" />
      </linearGradient>
    </defs>
    <circle cx="32" cy="32" r="29.5" fill="none" stroke={`url(#${id}-brand)`} stroke-width="3" stroke-dasharray="2.4 2.75" />
    <circle cx="32" cy="32" r="24" fill={`url(#${id}-brand)`} />
    <g class="logo__wheel" fill="none" stroke="#fff" stroke-width="3.6" stroke-linecap="round">
      <circle cx="32" cy="32" r="13.5" />
      <path d="M19.5 29.5h25M32 34v11" />
      <circle cx="32" cy="31" r="3.4" fill="#fff" stroke="none" />
    </g>
  </svg>
  {withText && (
    <span class="logo__text">
      <span class="logo__sub">Auto-école de la</span>
      <span class="logo__name">Préfecture</span>
    </span>
  )}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; }
  .logo__mark { flex: none; overflow: visible; }
  .logo__text { display: flex; flex-direction: column; gap: 3px; line-height: 1; }
  .logo__sub {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--brand-light);
    white-space: nowrap;
  }
  .logo__name {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 1.3rem;
    letter-spacing: -0.03em;
  }
  .logo__wheel { transform-box: view-box; transform-origin: 32px 32px; transition: transform 0.7s var(--ease-spring); }
  :global(a:hover) > .logo .logo__wheel { transform: rotate(-28deg); }
</style>
