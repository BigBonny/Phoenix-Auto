---
import Icon from './Icon.astro';
import Clip from './Clip.astro';
import { reviews, reviewThemes, site } from '../data/site';
const { rating, reviews: total, distribution } = site.google;
const maxTheme = Math.max(...reviewThemes.map((t) => t.count));
---
<section class="section section--sand" id="avis" aria-labelledby="avis-title">
  <div class="container">
    <div class="avis__head">
      <div class="section-head" style="margin-bottom:0">
        <p class="eyebrow" data-reveal>Avis Google</p>
        <h2 id="avis-title" class="section-title" data-split>
          La meilleure publicité, <span class="serif brand-text">ce sont nos élèves.</span>
        </h2>
      </div>
      <a href={site.social.google} class="avis__score card" target="_blank" rel="noopener" data-reveal style="--d:200ms">
        <span class="avis__google"><Icon name="google" /></span>
        <span>
          <span class="avis__rating">{rating.toLocaleString('fr-FR', { minimumFractionDigits: 1 })}<small>/5</small></span>
          <span class="avis__stars" aria-label={`Note de ${rating} sur 5`}>
            {[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}
          </span>
          <span class="avis__src">{total} avis · Voir sur Google <span class="sr-only">(nouvel onglet)</span></span>
        </span>
      </a>
    </div>

    {reviews.length > 0 && (
      <ul class="quotes" role="list">
        {reviews.map((r, i) => (
          <li data-reveal style={`--i:${i % 3}`}>
            <figure class="review card">
              <Icon name="quote" class="review__quote" />
              <div class="review__stars" aria-label="5 étoiles sur 5">
                {[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}
              </div>
              <blockquote class="review__text"><p>{r.text}</p></blockquote>
              <figcaption class="review__author">
                <span class="review__avatar" aria-hidden="true">{r.name.charAt(0)}</span>
                <span>
                  <strong>{r.name}</strong>
                  <span class="review__tag">{r.tag}</span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    )}

    <div class="avis__grid">
      <div class="card dist" data-reveal style="--i:0">
        <h3 class="avis__h">Répartition des notes</h3>
        <ul class="dist__list" role="list">
          {distribution.map((n, i) => (
            <li>
              <span class="dist__label">{5 - i} <Icon name="star" /></span>
              <span class="dist__bar" aria-hidden="true"><span style={`--w:${(n / total) * 100}%`}></span></span>
              <span class="dist__n">{n}<span class="sr-only"> avis</span></span>
            </li>
          ))}
        </ul>
        <p class="avis__note">{Math.round((distribution[0] / total) * 100)} % des élèves nous donnent 5 étoiles.</p>
      </div>

      <div class="card themes" data-reveal style="--i:1">
        <h3 class="avis__h">Ce que nos élèves soulignent</h3>
        <ul class="themes__list" role="list">
          {reviewThemes.map((t) => (
            <li style={`--s:${0.35 + 0.65 * (t.count / maxTheme)}`}>
              <span class="themes__label">{t.label}</span>
              <span class="themes__n">{t.count}<span class="sr-only"> avis</span></span>
            </li>
          ))}
        </ul>
        <p class="avis__note">Thèmes les plus cités dans nos avis Google, avec le nombre d’avis qui les mentionnent.</p>
      </div>

      <a href={site.google.url} class="review-cta" target="_blank" rel="noopener" data-reveal style="--i:2">
        <span class="review-cta__media" aria-hidden="true"><Clip id="05-reussite" /></span>
        <span class="review-cta__score">{rating.toLocaleString('fr-FR')}<small>/5</small></span>
        <span class="review-cta__stars" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</span>
        <span class="review-cta__text">{total} élèves nous ont notés sur Google. Lisez leurs témoignages, sans filtre.</span>
        <span class="review-cta__link">Lire tous les avis <Icon name="arrow" /><span class="sr-only">(nouvel onglet)</span></span>
      </a>
    </div>
  </div>
</section>

<style>
  .avis__head {
    display: flex; justify-content: space-between; align-items: flex-end; gap: var(--s-6); flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .avis__score { display: flex; align-items: center; gap: var(--s-4); padding: var(--s-5) var(--s-6); }
  .avis__score:hover { box-shadow: var(--shadow-2); transform: translateY(-3px); }
  .avis__google {
    display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;
    background: var(--sand); color: var(--fg);
  }
  .avis__rating { display: block; font-family: var(--font-display); font-weight: 750; font-size: 2rem; line-height: 1; letter-spacing: -0.04em; }
  .avis__rating small { font-size: 0.55em; color: var(--fg-muted); }
  .avis__stars { display: flex; gap: 2px; color: var(--star); margin-top: 6px; }
  .avis__stars :global(.icon) { width: 16px; height: 16px; }
  .avis__src { display: block; font-size: var(--fs-xs); color: var(--fg-muted); margin-top: 4px; text-decoration: underline; text-underline-offset: 3px; }

  /* Avis cités */
  .quotes {
    display: grid; gap: var(--s-4); margin-bottom: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }
  .quotes > li { display: flex; }
  .review { position: relative; overflow: hidden; display: flex; flex-direction: column; width: 100%; }
  .review:hover { transform: translateY(-4px); box-shadow: var(--shadow-2); }
  .review :global(.review__quote) {
    position: absolute; right: 20px; top: 18px; width: 44px; height: 44px;
    color: var(--sand-2); stroke-width: 1.25;
  }
  .review__stars { display: flex; gap: 2px; color: var(--star); }
  .review__stars :global(.icon) { width: 16px; height: 16px; }
  .review__text { margin-top: var(--s-4); font-size: 1.05rem; line-height: 1.6; max-width: 62ch; }
  .review__author { display: flex; align-items: center; gap: 12px; margin-top: auto; padding-top: var(--s-4); border-top: 1px solid var(--line); }
  .review__text + .review__author { margin-block-start: var(--s-5); }
  .review__avatar {
    display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; flex: none;
    font-weight: 700; background: var(--ink); color: var(--lime);
  }
  .review__author strong { display: block; font-size: var(--fs-sm); }
  .review__tag { display: block; font-size: var(--fs-xs); color: var(--fg-muted); }

  .avis__grid {
    display: grid; gap: var(--s-4);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) minmax(0, 0.9fr);
    align-items: stretch;
  }
  .avis__grid > * { min-width: 0; }
  .avis__h { font-size: 1.15rem; letter-spacing: -0.015em; }
  .avis__note { margin-top: var(--s-5); padding-top: var(--s-4); border-top: 1px solid var(--line); font-size: var(--fs-sm); color: var(--fg-muted); }

  /* Répartition */
  .dist, .themes { display: flex; flex-direction: column; }
  .dist .avis__note, .themes .avis__note { margin-top: auto; }
  .dist__list { display: grid; gap: 14px; margin-block: var(--s-5); }
  .dist__list li { display: grid; grid-template-columns: 34px 1fr 34px; align-items: center; gap: 12px; font-size: var(--fs-sm); font-variant-numeric: tabular-nums; }
  .dist__label { display: inline-flex; align-items: center; gap: 4px; font-weight: 600; }
  .dist__label :global(.icon) { width: 14px; height: 14px; color: var(--star); }
  .dist__bar { height: 10px; border-radius: var(--r-pill); background: var(--sand); overflow: hidden; }
  .dist__bar span {
    display: block; height: 100%; width: var(--w); min-width: 0; border-radius: inherit;
    background: linear-gradient(90deg, var(--brand), var(--brand-light));
    transform-origin: left; transition: transform 1.1s var(--ease-out) 0.25s;
  }
  :global(.js) [data-reveal]:not(.is-in) .dist__bar span { transform: scaleX(0); }
  .dist__n { text-align: right; color: var(--fg-muted); }

  /* Thèmes */
  .themes__list { display: flex; flex-wrap: wrap; gap: 10px; margin-block: var(--s-5); }
  .themes__list li {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 9px 10px 9px 16px; border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--brand-bright) calc(var(--s) * 16%), var(--paper));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand) calc(var(--s) * 34%), transparent);
    font-weight: 600; font-size: var(--fs-sm);
  }
  .themes__n {
    display: grid; place-items: center; min-width: 28px; height: 28px; padding-inline: 7px; border-radius: var(--r-pill);
    background: var(--ink); color: var(--lime); font-size: 0.8125rem; font-variant-numeric: tabular-nums;
  }

  /* CTA */
  .review-cta {
    position: relative; overflow: hidden;
    display: grid; gap: var(--s-2); justify-items: start; align-content: end;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    border-radius: var(--r-lg);
    background: var(--ink); color: var(--on-dark-muted);
    transition: transform var(--t-med) var(--ease-out), box-shadow var(--t-med);
  }
  .review-cta { min-height: 420px; }
  .review-cta__media { position: absolute; inset: 0; }
  .review-cta__media::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(11, 29, 21, 0.96) 0%, rgba(11, 29, 21, 0.8) 38%, rgba(11, 29, 21, 0.1) 75%);
  }
  .review-cta > :not(.review-cta__media) { position: relative; }
  .review-cta:hover { transform: translateY(-4px); box-shadow: var(--shadow-2); }
  .review-cta__score {
    font-family: var(--font-display); font-weight: 750; font-size: 3.5rem; line-height: 1;
    letter-spacing: -0.05em; color: var(--on-dark);
  }
  .review-cta__score small { font-size: 0.4em; color: var(--on-dark-muted); letter-spacing: 0; }
  .review-cta__stars { display: flex; gap: 2px; color: var(--star); }
  .review-cta__stars :global(.icon) { width: 18px; height: 18px; }
  .review-cta__text { margin-top: var(--s-2); }
  .review-cta__link { display: inline-flex; align-items: center; gap: 8px; margin-top: var(--s-3); font-weight: 600; color: var(--lime); min-height: 44px; }
  .review-cta__link :global(.icon) { width: 18px; height: 18px; transition: transform var(--t-med) var(--ease-out); }
  .review-cta:hover .review-cta__link :global(.icon) { transform: translateX(4px); }

  @media (max-width: 1020px) {
    .avis__grid { grid-template-columns: 1fr 1fr; }
    .review-cta { grid-column: 1 / -1; }
  }
  @media (max-width: 680px) {
    .avis__grid { grid-template-columns: 1fr; }
  }
</style>
