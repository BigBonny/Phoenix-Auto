  tiktok: '<path d="M9 12a4 4 0 1 0 4 4V2c.5 2.5 2.5 4.5 5 5"/>',
  google: '<path d="M21.8 10.2H12v3.9h5.6c-.5 2.6-2.7 4-5.6 4a6.1 6.1 0 1 1 4-10.7l2.8-2.8A10 10 0 1 0 12 22c5 0 9.6-3.6 9.8-9.6 0-.8 0-1.5-.1-2.2z"/>',
