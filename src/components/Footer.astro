---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, navLinks, formations } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer__cta" data-reveal>
      <p class="footer__big" aria-hidden="true">Prenez la <span class="serif brand-text">route.</span></p>
      <a href="#contact" class="btn btn--primary" data-magnetic>Réserver mon évaluation <Icon name="arrow" class="arrow" /></a>
    </div>

    <div class="footer__grid">
      <div class="footer__brand">
        <a href="#top" aria-label={`${site.name} — retour en haut`}><Logo size={40} id="ftr" /></a>
        <p>Auto-école à Nanterre (92), à deux pas de la Préfecture. Permis B, boîte automatique, conduite accompagnée et code de la route.</p>
        <ul class="footer__social" role="list">
          {site.social.instagram && <li><a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram (nouvel onglet)"><Icon name="instagram" /></a></li>}
          {site.social.tiktok && <li><a href={site.social.tiktok} target="_blank" rel="noopener" aria-label="TikTok (nouvel onglet)"><Icon name="tiktok" /></a></li>}
          <li><a href={site.social.google} target="_blank" rel="noopener" aria-label="Avis Google (nouvel onglet)"><Icon name="google" /></a></li>
        </ul>
      </div>
      <nav aria-label="Plan du site">
        <h2 class="footer__h">Navigation</h2>
        <ul role="list">{navLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <div>
        <h2 class="footer__h">Formations</h2>
        <ul role="list">{formations.map((f) => <li><a href="#formations">{f.title}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="footer__h">Contact</h2>
        <ul role="list">
          <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
          {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
          <li>{site.address.street}<br />{site.address.postalCode} {site.address.city}</li>
        </ul>
      </div>
    </div>

    <div class="footer__legal">
      <p>© {year} {site.name} · Agrément préfectoral n° {site.agrement} · SIRET {site.siret}</p>
      <ul role="list">
        <li><a href="/mentions-legales">Mentions légales</a></li>
        <li><a href="/mentions-legales#confidentialite">Confidentialité</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink); color: var(--on-dark-muted);
    padding-top: var(--section-y);
    padding-bottom: calc(var(--s-6) + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line-dark);
  }
  .footer__cta {
    display: flex; align-items: flex-end; justify-content: space-between; gap: var(--s-6); flex-wrap: wrap;
    padding-bottom: var(--s-8); border-bottom: 1px solid var(--line-dark);
  }
  .footer__big {
    font-family: var(--font-display); font-weight: 750; color: var(--on-dark);
    font-size: clamp(3rem, 1.5rem + 7vw, 8rem); line-height: 0.95; letter-spacing: -0.05em;
  }
  .footer__grid {
    display: grid; grid-template-columns: 1.4fr 1fr 1.2fr 1.2fr; gap: var(--s-6);
    padding-block: var(--s-8);
  }
  .footer__brand p { margin-top: var(--s-4); max-width: 34ch; font-size: var(--fs-sm); }
  .footer__brand > a { display: inline-flex; color: var(--on-dark); }
  .footer__social { display: flex; gap: var(--s-2); margin-top: var(--s-5); }
  .footer__social a {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-dark); color: var(--on-dark);
    transition: background var(--t-med), color var(--t-med), transform var(--t-med) var(--ease-out);
  }
  .footer__social a:hover { background: var(--lime); color: var(--ink); transform: translateY(-3px); }
  .footer__social :global(.icon) { width: 20px; height: 20px; }
  .footer__h { font-family: var(--font-body); font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.14em; color: var(--on-dark); font-weight: 600; margin-bottom: var(--s-4); }
  .footer__grid ul { display: grid; gap: 4px; font-size: var(--fs-sm); }
  .footer__grid ul a { display: inline-block; padding: 6px 0; transition: color var(--t-fast); }
  .footer__grid ul a:hover { color: var(--lime); }
  .footer__legal {
    display: flex; justify-content: space-between; gap: var(--s-4); flex-wrap: wrap;
    padding-top: var(--s-5); border-top: 1px solid var(--line-dark); font-size: var(--fs-xs);
  }
  .footer__legal ul { display: flex; gap: var(--s-5); }
  .footer__legal a:hover { color: var(--on-dark); }

  @media (max-width: 900px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .footer__grid { grid-template-columns: 1fr; } }
  @media (max-width: 860px) { .footer { padding-bottom: calc(96px + env(safe-area-inset-bottom)); } }
</style>
