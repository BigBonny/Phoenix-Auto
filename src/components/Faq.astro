---
import Icon from './Icon.astro';
import { faq, site } from '../data/site';
---
<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container faq">
    <div class="faq__intro">
      <p class="eyebrow" data-reveal>Questions fréquentes</p>
      <h2 id="faq-title" class="section-title" data-split>
        Tout ce que vous <span class="serif brand-text">voulez savoir.</span>
      </h2>
      <p class="section-lead" data-reveal style="--d:200ms">
        Une autre question ? Notre équipe vous répond par téléphone ou directement en agence.
      </p>
      <div class="faq__actions" data-reveal style="--d:300ms">
        <a href={`tel:${site.phoneHref}`} class="btn btn--ghost"><Icon name="phone" /> {site.phone}</a>
        {site.whatsapp ? <a href={`https://wa.me/${site.whatsapp}`} class="btn btn--ghost" target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a> : <a href={site.google.url} class="btn btn--ghost" target="_blank" rel="noopener"><Icon name="pin" /> Nous trouver</a>}
      </div>
    </div>

    <div class="faq__list">
      {faq.map((f, i) => (
        <details class="faq__item" name="faq" data-reveal style={`--i:${i}`} open={i === 0}>
          <summary>
            <span>{f.q}</span>
            <span class="faq__toggle" aria-hidden="true"><Icon name="plus" /></span>
          </summary>
          <div class="faq__answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2.5rem, 1rem + 5vw, 6rem); align-items: start; }
  .faq__intro { position: sticky; top: 120px; }
  .faq__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }

  .faq__list { display: grid; gap: var(--s-3); }
  .faq__item {
    background: var(--paper); border-radius: var(--r-md);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: box-shadow var(--t-med);
  }
  .faq__item[open] { box-shadow: inset 0 0 0 1.5px rgba(21, 128, 61, 0.35), var(--shadow-1); }
  summary {
    display: flex; justify-content: space-between; align-items: center; gap: var(--s-4);
    min-height: 64px; padding: var(--s-4) var(--s-5);
    font-family: var(--font-display); font-weight: 650; font-size: 1.08rem; letter-spacing: -0.015em;
    cursor: pointer; list-style: none; border-radius: var(--r-md);
  }
  summary::-webkit-details-marker { display: none; }
  .faq__toggle {
    flex: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%;
    background: var(--sand); transition: transform var(--t-med) var(--ease-out), background var(--t-med), color var(--t-med);
  }
  .faq__toggle :global(.icon) { width: 18px; height: 18px; }
  .faq__item[open] .faq__toggle { transform: rotate(45deg); background: var(--brand); color: #fff; }

  /* Ouverture fluide (navigateurs récents ; repli instantané ailleurs) */
  .faq__item::details-content {
    block-size: 0; overflow: clip;
    transition: block-size 0.45s var(--ease-out), content-visibility 0.45s allow-discrete;
  }
  .faq__item[open]::details-content { block-size: auto; }
  .faq__answer { padding: 0 var(--s-5) var(--s-5); color: var(--fg-muted); max-width: 62ch; }

  @media (max-width: 900px) {
    .faq { grid-template-columns: 1fr; }
    .faq__intro { position: static; }
  }
</style>
